{
  "name": "pln-filter-backend",
  "version": "1.0.0",
  "description": "Backend serverless para PLN Filter",
  "main": "serverless.yml",
  "scripts": {
    "deploy": "serverless deploy",
    "deploy:prod": "serverless deploy --stage prod",
