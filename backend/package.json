    "dynamodb",
    "websocket"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "serverless": "*",
    "serverless-dynamodb": "^0.2.56",
    "serverless-localstack": "^1.3.1",
    "serverless-offline": "^14.4.0",
    "serverless-offline-sqs": "^8.0.0",
    "serverless-python-requirements": "*"
  },
  "dependencies": {
    "@serverless/utils": "^6.15.0"
  }
}
