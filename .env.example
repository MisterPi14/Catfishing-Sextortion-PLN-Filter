# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=<tu_access_key>
AWS_SECRET_ACCESS_KEY=<tu_secret_key>

# DynamoDB
DYNAMODB_TABLE=ChatMessages
DYNAMODB_USERS_TABLE=Users
DYNAMODB_CONVERSATIONS_TABLE=Conversations

# SQS
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/<account-id>/pln-filter-messages

# API Gateway WebSocket
WEBSOCKET_API_ENDPOINT=https://<api-id>.execute-api.us-east-1.amazonaws.com/prod

# Lambda
NOTIFY_USER_LAMBDA_NAME=notify_user

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Risk Detection
RISK_THRESHOLD=0.7

# Logging
LOG_LEVEL=INFO
