@startuml
!theme vibrant

' Use rectangles for components and actors for external systems
actor User as "Usuario/Notebook"
database "File System" as FS
cloud "Ollama Service" as Ollama

package "Sistema de Evaluación de Modelos" {

  ' Componente principal que orquesta todo
  component "Main Execution" as Main {
    portin "start" as start_eval
  }

  ' Componente de orquestación de la evaluación
  component "evaluate_all_models" as Orchestrator

  ' Componentes de utilidad y acceso a datos
  component "get_available_models" as ModelGetter
  component "load_scam_examples_and_dictionary" as DataLoader
  component "export_to_json" as Exporter

  ' Componente de evaluación por modelo
  component "evaluate_model" as ModelEvaluator

  ' Componente de predicción
  component "get_model_prediction" as Predictor

  ' Componentes auxiliares
  component "get_metadata" as Metadata
  component "ensure_output_dir" as DirSetup
}

package "Dependencias Externas" {
    component "sklearn.metrics" as Sklearn
    component "subprocess" as Subprocess
}


' --- DEFINICIÓN DE RELACIONES ---

' El usuario inicia el proceso
User -down-> Main : "Ejecuta script con 'dataset' y 'client' definidos"

' Flujo principal de orquestación
Main -right-> Orchestrator : "evaluate_all_models(dataset)"
Orchestrator .up.> DirSetup : "ensure_output_dir()"
Orchestrator -> DataLoader : "load_scam_examples_and_dictionary()"
Orchestrator -> ModelGetter : "models_to_eval = get_available_models()"

' Bucle para evaluar cada modelo (iteración sobre models_to_eval)
Orchestrator --> ModelEvaluator : "evaluate_model(model_name_to_eval)"
Orchestrator --> Metadata : "get_metadata(model_name_to_eval, ...)"

Orchestrator --> Exporter : "export_to_json(...)"

' Interacciones de los componentes con sistemas externos y librerías
DataLoader .down.> FS : "Lee archivos .json de\n'scam-examples/sintetic'"
ModelGetter .down.> Subprocess : "Ejecuta 'ollama list'"
ModelGetter .down.> FS : "Lee reportes JSON existentes\nde 'OUTPUT_DIR' para\nexcluir modelos"

ModelEvaluator --> Predictor : "get_model_prediction(sample)"
ModelEvaluator .down.> Sklearn : "Usa classification_report()"

Predictor .right.> Ollama : "Envía prompt vía cliente HTTP"

Exporter .down.> FS : "Escribe reporte JSON en\n'OUTPUT_DIR'"

Main .down.> Subprocess : "Ejecuta 'shutdown' (opcional)"


' Notas adicionales para clarificar
note right of Orchestrator
  Este componente es el corazón
  de la lógica, llamando a otros
  para ejecutar el flujo completo
  de evaluación.
  
  Itera sobre cada modelo en
  models_to_eval para evaluar
  uno por uno.
end note

note top of ModelGetter
  Lógica de filtrado:
  1. Ejecuta 'ollama list' para obtener modelos disponibles
  2. Lee reportes JSON existentes del sistema de archivos
  3. Hace diferencia entre ambos conjuntos
  4. Devuelve solo modelos que faltan por evaluar
end note

note left of Predictor
  Construye el prompt final
  combinando el texto del mensaje,
  las definiciones, los ejemplos
  y el diccionario.
end note

@enduml
